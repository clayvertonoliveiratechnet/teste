{
  "hosting": [
    {
      "target": "technet-space",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"},
            {"key": "Clear-Site-Data", "value": "\"cache\""}
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {"key": "Cache-Control", "value": "no-cache, must-revalidate"}
          ]
        }
      ]
    }
  ]
}